NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/osms-dev?replicaSet=osms-dev-rs
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

# --- Security Configuration ---
# Allowed frontend origin(s) for CORS. Use a comma-separated list for multiple origins.
# Example: http://localhost:3000,https://app.example.com
FRONTEND_ORIGIN=http://localhost:3000

# Frontend application base URL for generating password reset and notification links
FRONTEND_URL=http://localhost:3000

# General API rate limit (per IP). Default: 100 requests per 15 minutes.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Authentication endpoint rate limit (stricter). Default: 10 failed requests per 15 minutes.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Account lockout. Default: 5 consecutive failed logins => 15-minute temporary lock.
ACCOUNT_LOCKOUT_MAX_ATTEMPTS=5
ACCOUNT_LOCKOUT_DURATION_MS=900000

# Maximum allowed request body size. Default: 10kb.
REQUEST_BODY_LIMIT=10kb

# --- AI Chatbot Configuration (ADR-010) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest
CHATBOT_RATE_LIMIT_WINDOW_MS=60000
CHATBOT_RATE_LIMIT_MAX=10
CHATBOT_TIMEOUT_MS=6000

# --- Email / Notification Configuration (ADR-004 §17) ---
# SMTP server settings. If left blank or unconfigured, notifications are logged to console (safe fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Darshana Opticals <noreply@darshanaopticals.com>

# Configurable System Admin development email (defaults to admin.dev@gmail.com)
# Admin accounts are excluded from password reset issuance by security policy (Issue #83 AC2/AC6).
DEV_ADMIN_EMAIL=admin.dev@gmail.com

# --- Cloudinary Image Storage Configuration (ADR-008 / DDP-076) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# --- PayHere Hosted Checkout (ADR-011) ---
# Use sandbox outside production. Never commit real merchant credentials.
PAYMENT_CURRENCY=LKR
PAYHERE_MODE=sandbox
PAYHERE_MERCHANT_ID=your_sandbox_merchant_id
PAYHERE_MERCHANT_SECRET=your_sandbox_merchant_secret
PAYHERE_RETURN_URL=http://localhost:3000/payments/return
PAYHERE_CANCEL_URL=http://localhost:3000/payments/cancel
PAYHERE_NOTIFY_URL=https://your-public-test-domain.example/api/payments/notify
PAYHERE_NOTIFY_RATE_LIMIT_WINDOW_MS=60000
PAYHERE_NOTIFY_RATE_LIMIT_MAX=600

# Optional read-only Merchant Retrieval API (not the Checkout Merchant Secret).
# Create the API App under the SAME sandbox merchant account. Never commit real values.
PAYHERE_API_APP_ID=
PAYHERE_API_APP_SECRET=
PAYHERE_RETRIEVAL_TIMEOUT_MS=8000

# --- Order Status Notification Delivery (ADR-013 / Issue #60) ---
# Customer web tracking portal base URL for transactional notification links
TRACKING_PORTAL_BASE_URL=http://localhost:3000
# AWS SES sender email
SES_FROM_EMAIL=Darshana Opticals <noreply@darshanaopticals.lk>

# --- Online Order Fulfillment Configuration ---
# Branch codeName designated for online catalog scoping and fulfillment. Default: GAMPAHA_CENTRAL
ONLINE_FULFILLMENT_BRANCH_CODE=GAMPAHA_CENTRAL
