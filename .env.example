NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/osms-dev
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

# --- Security Configuration ---
# Allowed frontend origin(s) for CORS. Use a comma-separated list for multiple origins.
# Example: http://localhost:3000,https://app.example.com
FRONTEND_ORIGIN=http://localhost:3000

# General API rate limit (per IP). Default: 100 requests per 15 minutes.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Authentication endpoint rate limit (stricter). Default: 10 requests per 15 minutes.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Maximum allowed request body size. Default: 10kb.
REQUEST_BODY_LIMIT=10kb
