NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/osms-dev?replicaSet=osms-dev-rs
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=24h

# --- Security Configuration ---
# Allowed frontend origin(s) for CORS. Use a comma-separated list for multiple origins.
# Example: http://localhost:3000,https://app.example.com
FRONTEND_ORIGIN=http://localhost:3000

# Frontend application base URL for generating password reset and notification links
FRONTEND_URL=http://localhost:3000

# General API rate limit (per IP). Default: 100 requests per 15 minutes.
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Authentication endpoint rate limit (stricter). Default: 10 requests per 15 minutes.
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10

# Maximum allowed request body size. Default: 10kb.
REQUEST_BODY_LIMIT=10kb

# --- AI Chatbot Configuration (ADR-010) ---
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-flash-lite-latest
CHATBOT_RATE_LIMIT_WINDOW_MS=60000
CHATBOT_RATE_LIMIT_MAX=10
CHATBOT_TIMEOUT_MS=6000

# --- Email / Notification Configuration (ADR-004 §17) ---
# SMTP server settings. If left blank or unconfigured, notifications are logged to console (safe fallback).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Darshana Opticals <noreply@darshanaopticals.com>

# --- Cloudinary Image Storage Configuration (ADR-008 / DDP-076) ---
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

